{
	"name": "@substrate-kit/cli",
	"version": "0.1.2",
	"description": "Scaffold interactive canvas playgrounds with Substrate primitives",
	"type": "module",
	"bin": {
		"substrate-kit": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsx src/index.ts",
		"prepack": "cp ../../registry.json registry.json && npm run build",
		"prepublishOnly": "npm --prefix ../.. run release:check"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.28.0",
		"chalk": "^5.4.0",
		"commander": "^13.0.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0"
	},
	"files": [
		"dist",
		"skills",
		"registry.json",
		".claude-plugin"
	],
	"keywords": [
		"substrate",
		"canvas",
		"design-tool",
		"claude",
		"skills"
	],
	"license": "MIT"
}
