{
	"name": "@substrate-kit/cli",
	"version": "0.3.0",
	"description": "Add Substrate components, skills and docs to a project, with an MCP server for agents",
	"type": "module",
	"bin": {
		"substrate-kit": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsx src/index.ts",
		"prepack": "node ../../scripts/bundle-cli-assets.mjs && npm run build",
		"prepublishOnly": "node ../../scripts/release-stamp.mjs verify"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.28.0",
		"chalk": "^5.4.0",
		"commander": "^13.0.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0"
	},
	"files": [
		"dist",
		"skills",
		"templates",
		"docs",
		"registry.json",
		".claude-plugin"
	],
	"keywords": [
		"substrate",
		"canvas",
		"design-tool",
		"claude",
		"skills"
	],
	"license": "MIT"
}
